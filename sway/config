# ############################################################################
# CONFIGURACIÓN SWAY
# ############################################################################

# Tecla Principal: Mod4 es la tecla Windows / Super
set $mod Mod4

# Al principio de tu archivo o en la sección de exec
exec dbus-update-activation-environment --systemd WAYLAND_DISPLAY XDG_CURRENT_DESKTOP=sway

# Variables de Aplicaciones
set $term kitty
set $menu tofi-run | xargs swaymsg exec --

# Fuentes
font pango:Google Sans Flex 11

#decoracion
for_window [class="^.*"] border pixel 3
#modo flotante visor de imagen imv
for_window [app_id="imv"] floating enable

# --- AUTOSTART ---
# Requiere: nm-applet, swayidle, swaylock, xorg-xwayland
exec --no-startup-id nm-applet --indicator


# Esto actualiza las variables de entorno para que D-Bus encuentre a Mako
exec dbus-update-activation-environment --systemd WAYLAND_DISPLAY XDG_CURRENT_DESKTOP=sway
exec mako

# Gestión de energía y bloqueo (sustituye xss-lock)
exec swayidle -w \
         timeout 300 'swaylock -c 282828' \
         before-sleep 'swaylock -c 282828'

# --- CONTROLES DE AUDIO (PACTL) ---
bindsym XF86AudioRaiseVolume exec pactl set-sink-volume @DEFAULT_SINK@ +5%
bindsym XF86AudioLowerVolume exec pactl set-sink-volume @DEFAULT_SINK@ -5%
bindsym XF86AudioMute exec pactl set-sink-mute @DEFAULT_SINK@ toggle

# --- CONTROL DE BRILLO ---
# Aumentar brillo en un 5%
bindsym XF86MonBrightnessUp exec brightnessctl set +5%
# Disminuir brillo en un 5%
bindsym XF86MonBrightnessDown exec brightnessctl set 5%-

# --- CAPTURAS DE PANTALLA (ESTILO END-4) ---
# 1. Capturar pantalla completa y copiar al portapapeles
bindsym Print exec grim - | tee ~/Pictures/Screenshots/$(date +%Y-%m-%d_%H-%m-%s).png | wl-copy && notify-send "Captura" "Pantalla completa guardada y copiada" -i image-x-generic
# 2. Seleccionar área y abrir editor interactivo (Swappy)
# Este es el que permite dibujar flechas y anotar
bindsym $mod+Print exec grim -g "$(slurp)" - | swappy -f -
# 3. Capturar área directamente al portapapeles (sin editar)
bindsym $mod+Shift+s exec grim -g "$(slurp)" - | wl-copy && notify-send "Captura" "Área copiada al portapapeles"


# --- LANZAMIENTO DE APLICACIONES ---
bindsym $mod+Return exec $term
bindsym $mod+m exec $menu
bindsym $mod+n exec thunar
bindsym $mod+b exec firefox
bindsym $mod+o exec microsoft-edge-stable --enable-features=UseOzonePlatform --ozone-platform=wayland %U
# --- GESTIÓN DE VENTANAS ---
floating_modifier $mod
bindsym $mod+q kill
bindsym $mod+f fullscreen toggle
bindsym $mod+Shift+space floating toggle
bindsym $mod+Shift+t focus mode_toggle

# --- NAVEGACIÓN (SOLO FLECHAS) ---

# Cambiar el foco entre ventanas
bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right

# Mover la ventana de posición
bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Right move right

# --- DISEÑO DE MOSAICO (LAYOUTS) ---
bindsym $mod+h split h
bindsym $mod+v split v
bindsym $mod+s layout stacking
bindsym $mod+w layout tabbed
bindsym $mod+e layout toggle split

# --- ESCRITORIOS (WORKSPACES) ---
set $ws1 "1"
set $ws2 "2"
set $ws3 "3"
set $ws4 "4"
set $ws5 "5"

bindsym $mod+1 workspace number $ws1
bindsym $mod+2 workspace number $ws2
bindsym $mod+3 workspace number $ws3
bindsym $mod+4 workspace number $ws4
bindsym $mod+5 workspace number $ws5

bindsym $mod+Shift+1 move container to workspace number $ws1
bindsym $mod+Shift+2 move container to workspace number $ws2
bindsym $mod+Shift+3 move container to workspace number $ws3
bindsym $mod+Shift+4 move container to workspace number $ws4
bindsym $mod+Shift+5 move container to workspace number $ws5

# --- MODO REDIMENSIONAR (SOLO FLECHAS) ---
mode "resize" {
    bindsym Left resize shrink width 10 px or 10 ppt
    bindsym Down resize grow height 10 px or 10 ppt
    bindsym Up resize shrink height 10 px or 10 ppt
    bindsym Right resize grow width 10 px or 10 ppt

    # Volver al modo normal
    bindsym Return mode "default"
    bindsym Escape mode "default"
    bindsym $mod+r mode "default"
}
bindsym $mod+r mode "resize"

# --- GESTIÓN DEL SISTEMA ---
bindsym $mod+Shift+c reload
bindsym $mod+Shift+e exec "sway-nagbar -t warning -m '¿Cerrar sesión de Sway?' -B 'Sí, salir' 'swaymsg exit'"

# --- ESTÉTICA (GAPS Y BORDES) ---
gaps inner 5
gaps outer 5
default_border pixel 3
#client.focused #4c7899 #285577 #ffffff #2e9ef4 #285577
client.focused    #00bcff #00bcff #ffffff #00bcff   #00bcff
# --- BARRA DE ESTADO ---
bar {
    swaybar_command waybar
    font pango:Hack Nerd Font 12
    position top
    colors {
        statusline #ffffff
        background #282828
        focused_workspace #4c7899 #285577 #ffffff
        active_workspace #333333 #5f676a #ffffff
        inactive_workspace #333333 #222222 #888888
    }
}

# Configura los idiomas (ejemplo: US y Español)
input "type:keyboard" {
    xkb_layout "us,es"
    # Esto permite cambiar de idioma presionando Alt + Shift
    xkb_options "grp:alt_shift_toggle"
}

#Fondo de pantalla
output * bg ~/Pictures/Wallpapers/islas.jpg fill
